# Key the local API accepts. Leave empty to accept any bearer token.
RIGHTPEOPLE_API_KEY=sk-local-dev
# Where SDK examples send requests.
RIGHTPEOPLE_BASE_URL=http://localhost:8787/v1
PORT=8787
# OpenAI-compatible backend behind rightpeople-beta (chat) and rightpeople-embed (embeddings).
# Locally this is Ollama; production uses vLLM on the GPU instance (see infra/terraform).
INFERENCE_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text:v1.5
# Set to "echo" for the deterministic stand-in used by tests.
# RIGHTPEOPLE_ENGINE=echo
