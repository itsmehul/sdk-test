# Key the local API accepts. Leave empty to accept any bearer token.
INTERFAZE_API_KEY=sk-local-dev
# Where SDK examples send requests.
INTERFAZE_BASE_URL=http://localhost:8787/v1
PORT=8787
# Ollama backing interfaze-beta (chat) and interfaze-embed (embeddings).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=tinyllama
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
