    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-auto-scaling": "^3.1146.0",
    "@aws-sdk/client-ec2": "^3.1146.0",
    "@aws-sdk/client-ssm": "^3.1146.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
