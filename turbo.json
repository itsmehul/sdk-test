{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "RIGHTPEOPLE_API_KEY",
    "RIGHTPEOPLE_BASE_URL",
    "RIGHTPEOPLE_ENGINE",
    "PORT",
    "INFERENCE_BASE_URL",
    "INFERENCE_API_KEY",
    "CHAT_MODEL",
    "EMBED_MODEL"
  ],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint:pkg": {
      "dependsOn": ["build"]
    },
    "lint:types": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
