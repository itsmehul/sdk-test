{
  "name": "@rightpeople/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the RightPeople API",
  "keywords": [
    "rightpeople",
    "ai",
    "llm",
    "openai-compatible",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rightpeople/sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi/openapi.json -o src/generated/schema.d.ts",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:pkg": "publint --strict",
    "lint:types": "attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rightpeople/api": "workspace:*",
    "@types/node": "^26.6.4",
    "openapi-typescript": "^7.13.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
